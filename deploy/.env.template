# CaDS Tutor whisper-service — runtime env template (NAMES + descriptions only; NO secret values).
# Copy to .env, fill in, run with: docker run --env-file .env -p 8756:8756 cads-whisper-service:latest

# Required for any deployment reachable outside localhost (e.g. behind a public tunnel) -
# gates POST /transcribe with "Authorization: Bearer <key>". GET /health never needs it.
WHISPER_SERVICE_API_KEY=

# --- everything below is baked into the image; override only if you must ---
# WHISPER_SERVICE_PORT=8756
# WHISPER_CLI_PATH=/app/vendor/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/app/vendor/whisper.cpp/models/ggml-base.bin
