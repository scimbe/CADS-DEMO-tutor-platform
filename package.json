{
  "name": "@cads/tutor-platform",
  "version": "0.10.0",
  "description": "Shared grounding/citation engine for CaDS Tutor - reference-sourced content for both the Rust and Firmware tutors, never LLM-generated language facts.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "content-packs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "ingest": "tsc && node dist/cli/ingest.js",
    "tutor": "tsc && node --env-file=.env dist/cli/tutor.js",
    "frontier": "tsc && node dist/cli/frontier.js",
    "whisper-service": "tsc && node dist/cli/whisper-service.js",
    "setup-whisper": "bash scripts/setup-whisper-cpp.sh"
  },
  "peerDependencies": {
    "student-memory": "github:scimbe/CADS-DEMO-student-memory"
  },
  "peerDependenciesMeta": {
    "student-memory": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "student-memory": "github:scimbe/CADS-DEMO-student-memory",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
